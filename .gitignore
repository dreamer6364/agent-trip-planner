# ==========================================
# Trip Planner .gitignore
# ==========================================

# ------------------------------------------
# Java / Maven
# ------------------------------------------
target/
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*
.mvn/wrapper/maven-wrapper.jar

# Maven 包装器生成的文件
.mvn/timing.properties

# ------------------------------------------
# IDE
# ------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.launch

# IntelliJ IDEA
out/
production/

# Eclipse
.bin/
.settings/

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ------------------------------------------
# 操作系统
# ------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ------------------------------------------
# 环境配置 (敏感信息)
# ------------------------------------------
.env
.env.local
.env.*.local
.env.production
*.pem
*.key
*.crt
secrets/
*.keystore
*.jks

# ------------------------------------------
# 日志
# ------------------------------------------
logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ------------------------------------------
# 数据库
# ------------------------------------------
*.sql
*.dump
*.sqlite
*.db
data/
mysql_data/
redis_data/

# ------------------------------------------
# Docker
# ------------------------------------------
.docker/
docker-compose.override.yml
.dockerignore

# ------------------------------------------
# 前端
# ------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
frontend/.eslintcache
frontend/coverage/
frontend/*.local

# ------------------------------------------
# 测试覆盖率
# ------------------------------------------
coverage/
.jacoco/
*.exec

# ------------------------------------------
# 临时文件
# ------------------------------------------
tmp/
temp/
*.tmp
*.temp
*.bak
*.swp

# ------------------------------------------
# 编译输出
# ------------------------------------------
*.class
*.jar
*.war
*.ear
target/
build/
dist/
out/

# ------------------------------------------
# 依赖缓存
# ------------------------------------------
.gradle/
.m2/
npm-cache/
.yarn-cache/

# ------------------------------------------
# 文档生成
# ------------------------------------------
docs/_build/
site/
target/site/
target/generated-docs/

# ------------------------------------------
# 部署相关
# ------------------------------------------
k8s/*.secret.yml
helm/*/values-prod.yml
ansible/*.vault.yml

# ------------------------------------------
# OS/编辑器特定
# ------------------------------------------
*.orig
*.rej
*.patch
*.diff
*.save
*.swp
*.swo
*~

# ------------------------------------------
# 保留的文件 (显式允许)
# ------------------------------------------
!.gitignore
!.gitkeep
!.editorconfig
!docker-compose.yml
!.env.example
!README.md
!LICENSE

# ------------------------------------------
# 本项目补充规则
# ------------------------------------------
# 前端依赖与构建产物（dist 由 npm run build 重建）
frontend-new/node_modules/
frontend-new/.vite/
node_modules/

# robocopy 到 gateway 的静态资源（由前端构建管线重建）
gateway/src/main/resources/static/

# 数据库 schema 是源码资产，覆盖上方 *.sql 规则
!init-sql/
!init-sql/*.sql

# 运行时调试/报告产物
agent-fallback-debug.txt
e2e-*-report.txt
stdout.log
