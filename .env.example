# ==========================================
# Trip Planner 环境变量配置模板
# 复制为 .env 并修改对应值
# ==========================================

# ------------------------------------------
# 应用基础配置
# ------------------------------------------
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080
SPRING_APPLICATION_NAME=trip-planner

# ------------------------------------------
# MySQL 配置
# ------------------------------------------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=trip_planner
MYSQL_USER=trip_planner
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme

# 连接池配置
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=20
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=5
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=30000
SPRING_DATASOURCE_HIKARI_IDLE_TIMEOUT=600000
SPRING_DATASOURCE_HIKARI_MAX_LIFETIME=1800000

# ------------------------------------------
# Redis 配置
# ------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT_MS=5000
REDIS_LETTUCE_POOL_MAX_ACTIVE=20
REDIS_LETTUCE_POOL_MAX_IDLE=10
REDIS_LETTUCE_POOL_MIN_IDLE=5

# ------------------------------------------
# Kafka 配置
# ------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONSUMER_GROUP_PLANNING=planning-worker-group
KAFKA_CONSUMER_GROUP_NOTIFICATION=notification-service-group
KAFKA_CONSUMER_GROUP_GEO=geo-worker-group
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_RETRIES=3
KAFKA_PRODUCER_BATCH_SIZE=16384
KAFKA_PRODUCER_LINGER_MS=5

# ------------------------------------------
# JWT 配置 (RS256 非对称加密)
# 生成命令:
# openssl genrsa -out private_key.pem 2048
# openssl rsa -in private_key.pem -pubout -out public_key.pem
# JWT_PRIVATE_KEY=$(cat private_key.pem | sed ':a;N;s/\n/\\n/g;ta')
# JWT_PUBLIC_KEY=$(cat public_key.pem | sed ':a;N;s/\n/\\n/g;ta')
# ------------------------------------------
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQD...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...\n-----END PUBLIC KEY-----"
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=30
JWT_ISSUER=trip-planner

# ------------------------------------------
# 高德地图 API
# 申请地址: https://lbs.amap.com/
# ------------------------------------------
AMAP_API_KEY=your_amap_api_key
AMAP_API_SECRET=your_amap_api_secret
AMAP_WEB_SERVICE_KEY=your_amap_web_service_key
AMAP_QPS_LIMIT=50
AMAP_GEOCODE_URL=https://restapi.amap.com/v3/geocode/geo
AMAP_REGEOCODE_URL=https://restapi.amap.com/v3/geocode/regeo
AMAP_ROUTE_URL=https://restapi.amap.com/v3/direction/driving
AMAP_TRANSIT_URL=https://restapi.amap.com/v3/direction/transit/integrated
AMAP_WALK_URL=https://restapi.amap.com/v3/direction/walking
AMAP_BICYCLE_URL=https://restapi.amap.com/v4/direction/bicycling

# ------------------------------------------
# 百度地图 API (备选/降级)
# 申请地址: https://lbsyun.baidu.com/
# ------------------------------------------
BAIDU_API_KEY=your_baidu_api_key
BAIDU_API_SECRET=your_baidu_api_secret
BAIDU_QPS_LIMIT=30
BAIDU_GEOCODE_URL=https://api.map.baidu.com/geocoding/v3
BAIDU_ROUTE_URL=https://api.map.baidu.com/direction/v2/driving
BAIDU_TRANSIT_URL=https://api.map.baidu.com/direction/v2/transit

# ------------------------------------------
# LLM API (用于自然语言解析)
# 支持 OpenAI 兼容接口
# ------------------------------------------
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=30

# 备选本地模型 (Ollama)
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=qwen2.5:7b

# ------------------------------------------
# 规划引擎配置
# ------------------------------------------
PLANNING_SOLVER_TIMEOUT_SECONDS=30
PLANNING_SOLVER_WORKERS=4
PLANNING_HEURISTIC_MAX_ITERATIONS=1000
PLANNING_MAX_POI_EXACT=15
PLANNING_WORKER_CONCURRENCY=4

# ------------------------------------------
# 限流配置
# ------------------------------------------
RATE_LIMIT_DEFAULT_QPS=100
RATE_LIMIT_AUTH_QPS=10
RATE_LIMIT_PLAN_QPS=5

# ------------------------------------------
# 文件上传配置
# ------------------------------------------
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=10MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=50MB

# ------------------------------------------
# 监控配置
# ------------------------------------------
VICTORIA_METRICS_URL=http://victoria-metrics:8428
JAEGER_ENDPOINT=http://jaeger:4318/v1/traces
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
MANAGEMENT_PROMETHEUS_METRICS_EXPORT_ENABLED=true

# ------------------------------------------
# 前端配置 (由前端构建时注入)
# ------------------------------------------
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_BASE_URL=ws://localhost:8081
VITE_AMAP_KEY=your_amap_web_key
VITE_APP_TITLE=Trip Planner

# ------------------------------------------
# 日志配置
# ------------------------------------------
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_TRIPPLANNER=DEBUG
LOGGING_PATTERN_CONSOLE=%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n
LOGGING_PATTERN_FILE=%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n